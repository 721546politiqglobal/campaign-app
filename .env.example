# ── Supabase — required ───────────────────────────────────────────────────────
# Get from: your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key — safe to ship to the browser. Used client-side for
# direct-to-storage avatar photo/video uploads (bypasses serverless function
# payload limits).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Server-only — bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth — required in production ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Site URL — required for invite links and Stripe billing-portal redirects ─
# Must be an absolute URL (e.g. http://localhost:3000 in dev).
NEXT_PUBLIC_SITE_URL=

# ── Cron auth — REQUIRED in production. Vercel injects this on cron requests. ─
# Routes fail closed (401) when this is unset. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── AI content drafting — activates ClaudeContentGenerator ───────────────────
# Get from: https://console.anthropic.com → API Keys
LLM_API_KEY=

# ── Candidate avatar video — activates HeyGenVideoProvider ───────────────────
# Requires: signed candidate consent + political-use approval on your plan
HEYGEN_API_KEY=
# Per-campaign avatar/voice ids live on candidate_profiles — leave these blank.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ── Voice synthesis — activates ElevenLabsVoiceProvider ──────────────────────
# Requires: signed candidate consent + political-use approval on your plan
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Social publishing — activates AyrsharePublisher ──────────────────────────
# Requires: per-platform political-content authorization (Meta, TikTok, X)
AYRSHARE_API_KEY=

# ── Opponent monitoring — activates NewsDataMonitoringSource ─────────────────
NEWSDATA_API_KEY=

# ── Monitoring ingest — REQUIRED for the n8n opposition-monitoring workflow ──
# Dedicated bearer token for POST /api/monitoring/ingest and GET
# /api/monitoring/campaigns. Do NOT reuse SUPABASE_SERVICE_ROLE_KEY here.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONITORING_INGEST_SECRET=

# ── Billing — activates Stripe subscriptions + metered usage ────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get from: https://dashboard.stripe.com/test/webhooks after creating the
# endpoint pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
