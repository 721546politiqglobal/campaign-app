    "NewsData: Fetch":  { "main": [[{ "node": "NewsData: Format",     "type": "main", "index": 0 }]] },
    "NewsData: Format": { "main": [[{ "node": "NewsData: Send to App", "type": "main", "index": 0 }]] },
    "GDELT: Fetch":     { "main": [[{ "node": "GDELT: Format",        "type": "main", "index": 0 }]] },
    "GDELT: Format":    { "main": [[{ "node": "GDELT: Send to App",    "type": "main", "index": 0 }]] }
  },
  "active": false,
