{
  "name": "Command Center — Opposition Monitoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "campaign_id",
              "value": "camp-1",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "campaign_name",
              "value": "Rivera for Assembly",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "opponent_names",
              "value": "John Smith, Smith Campaign",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "keywords",
              "value": "Rivera, District 12, California Assembly",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "newsdata_api_key",
              "value": "YOUR_NEWSDATA_API_KEY",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "app_base_url",
              "value": "http://localhost:3001",
              "type": "string"
            },
            {
              "id": "f7",
              "name": "app_auth_key",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Campaign Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 320]
    },
    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst opp = c.opponent_names.split(',').map(s => s.trim()).filter(Boolean);\nconst kw  = c.keywords.split(',').map(s => s.trim()).filter(Boolean);\nconst terms = [...opp, ...kw].slice(0, 5);\nreturn [{ json: { ...c, opponent_names_array: opp, keywords_array: kw, query_string: terms.join(' OR ') } }];"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Prepare Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 320]
    },
    {
      "parameters": {
        "url": "https://newsdata.io/api/1/news",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "apikey",   "value": "={{ $json.newsdata_api_key }}" },
            { "name": "q",        "value": "={{ $json.query_string }}" },
            { "name": "language", "value": "en" },
            { "name": "country",  "value": "us" },
            { "name": "size",     "value": "10" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "NewsData: Fetch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').first().json;\nconst res = $input.first().json;\nif (!res || !Array.isArray(res.results)) return [];\nreturn res.results\n  .filter(a => a && a.link)\n  .slice(0, 15)\n  .map(a => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: String(a.source_id || 'NewsData'),\n    opponent: cfg.opponent_names_array.find(o =>\n      (String(a.title || '') + ' ' + String(a.description || '')).toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(a.description || a.title || '').substring(0, 500),\n    url: String(a.link)\n  }}));"
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "NewsData: Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Prepare Query').first().json.app_base_url + '/api/monitoring/ingest' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Prepare Query').first().json.app_auth_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "campaign_id", "value": "={{ $json.campaign_id }}" },
            { "name": "source",      "value": "={{ $json.source }}" },
            { "name": "opponent",    "value": "={{ $json.opponent }}" },
            { "name": "excerpt",     "value": "={{ $json.excerpt }}" },
            { "name": "url",         "value": "={{ $json.url }}" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "NewsData: Send to App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "https://api.gdeltproject.org/api/v2/doc/doc",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query",      "value": "={{ $json.query_string }}" },
            { "name": "mode",       "value": "artlist" },
            { "name": "maxrecords", "value": "20" },
            { "name": "format",     "value": "json" },
            { "name": "timespan",   "value": "24h" },
            { "name": "sort",       "value": "DateDesc" },
            { "name": "sourcelang", "value": "english" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "GDELT: Fetch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 460],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').first().json;\nconst res = $input.first().json;\nif (!res || !Array.isArray(res.articles)) return [];\nreturn res.articles\n  .filter(a => a && a.url)\n  .slice(0, 15)\n  .map(a => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: 'GDELT',\n    opponent: cfg.opponent_names_array.find(o =>\n      String(a.title || '').toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(a.title || '').substring(0, 500),\n    url: String(a.url)\n  }}));"
      },
      "id": "88888888-8888-8888-8888-888888888888",
      "name": "GDELT: Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Prepare Query').first().json.app_base_url + '/api/monitoring/ingest' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Prepare Query').first().json.app_auth_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "campaign_id", "value": "={{ $json.campaign_id }}" },
            { "name": "source",      "value": "={{ $json.source }}" },
            { "name": "opponent",    "value": "={{ $json.opponent }}" },
            { "name": "excerpt",     "value": "={{ $json.excerpt }}" },
            { "name": "url",         "value": "={{ $json.url }}" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "99999999-9999-9999-9999-999999999999",
      "name": "GDELT: Send to App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 460],
      "continueOnFail": true
    }
  ],
