    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.app_base_url + '/api/monitoring/campaigns' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222299",
      "name": "Get Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 700],
      "credentials": {
        "httpHeaderAuth": { "id": "1", "name": "Campaign App Service Auth" }
      }
    },
    {
      "parameters": {
        "jsCode": "const appCfg = $('App Config').first().json;\n// Get Campaigns returns one n8n item per campaign already (the HTTP node\n// splits the JSON array response), so map over every input item rather than\n// assuming a single item wraps the whole array.\nreturn $input.all().map(item => {\n  const c = item.json;\n  const opp = [c.opponent_name, ...(c.opponent_aliases || [])].filter(Boolean);\n  const kw = c.monitoring_keywords || [];\n  const terms = [...opp, ...kw].slice(0, 5);\n  // Quote multi-word terms so Twitter/NewsData/YouTube treat them as phrases,\n  // not an ambiguous mix of implicit AND/OR on bare words.\n  const quoted = terms.map(t => t.includes(' ') ? '\"' + t + '\"' : t);\n  return { json: {\n    ...c,\n    app_base_url: appCfg.app_base_url,\n    opponent_names_array: opp,\n    keywords_array: kw,\n    query_string: quoted.join(' OR '),\n    gdelt_query_string: quoted.join(' OR '),\n  }};\n});"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Prepare Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 700]
    },
    {
      "parameters": {
        "url": "https://newsdata.io/api/1/news",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q",        "value": "={{ $json.query_string }}" },
            { "name": "language", "value": "en" },
            { "name": "country",  "value": "us" },
            { "name": "size",     "value": "10" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "NewsData: Fetch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300],
      "continueOnFail": true,
      "credentials": {
        "httpQueryAuth": { "id": "2", "name": "NewsData API Key" }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').item.json;\nconst res = $input.first().json;\nif (!res || !Array.isArray(res.results)) return [];\nreturn res.results\n  .filter(a => a && a.link)\n  .slice(0, 15)\n  .map(a => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: String(a.source_id || 'NewsData'),\n    opponent: cfg.opponent_names_array.find(o =>\n      (String(a.title || '') + ' ' + String(a.description || '')).toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(a.description || a.title || '').substring(0, 500),\n    url: String(a.link)\n  }}));"
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "NewsData: Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300]
    },
