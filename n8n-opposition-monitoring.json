    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').item.json;\nconst res = $input.first().json;\nif (!res || !Array.isArray(res.data)) return [];\nreturn res.data\n  .filter(t => t && t.text)\n  .slice(0, 15)\n  .map(t => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: 'Twitter/X',\n    opponent: cfg.opponent_names_array.find(o =>\n      t.text.toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(t.text || '').substring(0, 500),\n    url: 'https://twitter.com/i/web/status/' + t.id\n  }}));"
