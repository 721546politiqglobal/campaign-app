    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').item.json;\nconst res = $input.first().json;\n// GDELT returns a plain-text error body (not JSON) on a malformed query —\n// catch that case explicitly instead of the previous no-op `res.data` check.\nif (!res || typeof res === 'string' || !Array.isArray(res.articles)) return [];\nreturn res.articles\n  .filter(a => a && a.url)\n  .slice(0, 15)\n  .map(a => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: 'GDELT',\n    opponent: cfg.opponent_names_array.find(o =>\n      String(a.title || '').toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(a.title || '').substring(0, 500),\n    url: String(a.url)\n  }}));"
      },
