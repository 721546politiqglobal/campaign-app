    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').item.json;\nconst res = $input.first().json;\nif (!res || !Array.isArray(res.items)) return [];\nreturn res.items\n  .filter(v => v && v.id && v.id.videoId)\n  .slice(0, 10)\n  .map(v => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: 'YouTube',\n    opponent: cfg.opponent_names_array.find(o =>\n      (String((v.snippet || {}).title || '') + ' ' + String((v.snippet || {}).description || '')).toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String((v.snippet || {}).title || '') + ' — ' + String((v.snippet || {}).description || '').substring(0, 300),\n    url: 'https://www.youtube.com/watch?v=' + v.id.videoId\n  }}));"
