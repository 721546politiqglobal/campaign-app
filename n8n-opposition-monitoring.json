    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst opp = c.opponent_names.split(',').map(s => s.trim()).filter(Boolean);\nconst kw  = c.keywords.split(',').map(s => s.trim()).filter(Boolean);\nconst terms = [...opp, ...kw].slice(0, 5);\nconst gdeltTerms = terms.map(t => t.includes(' ') ? '\"' + t + '\"' : t);\nreturn [{ json: { ...c, opponent_names_array: opp, keywords_array: kw, query_string: terms.join(' OR '), gdelt_query_string: gdeltTerms.join(' OR ') } }];"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Prepare Query",
