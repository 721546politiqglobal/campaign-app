      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').item.json;\nconst res = $input.first().json;\n// The Instagram profile scraper returns one profile object per input item,\n// with recent posts nested under latestPosts — not a bare array or `.items`.\nconst items = Array.isArray(res) ? res\n  : (res && Array.isArray(res.latestPosts)) ? res.latestPosts\n  : (res && Array.isArray(res.items)) ? res.items\n  : [];\nif (!items.length) return [];\nreturn items\n  .filter(p => p && (p.url || p.shortCode))\n  .slice(0, 15)\n  .map(p => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: 'Instagram',\n    opponent: cfg.opponent_names_array.find(o =>\n      String(p.caption || p.text || '').toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(p.caption || p.text || '').substring(0, 500),\n    url: p.url || ('https://www.instagram.com/p/' + p.shortCode + '/')\n  }}));"
      },
      "id": "c3d4e5f6-a7b8-4912-cdef-000000000002",
      "name": "Instagram: Format",
