    {
      "parameters": {
        "jsCode": "const cfg = $('Prepare Query').item.json;\n// Facebook posts scraper returns a bare array of posts, which n8n auto-splits\n// into separate input items — map over every input item rather than\n// assuming a single item wraps the whole array (same bug class as Prepare Query).\nconst items = $input.all().map(item => item.json);\nif (!items.length) return [];\nreturn items\n  .filter(p => p && p.url)\n  .slice(0, 15)\n  .map(p => ({ json: {\n    campaign_id: cfg.campaign_id,\n    source: 'Facebook',\n    opponent: cfg.opponent_names_array.find(o =>\n      String(p.text || p.message || '').toLowerCase().includes(o.toLowerCase())\n    ) || null,\n    excerpt: String(p.text || p.message || '').substring(0, 500),\n    url: String(p.url)\n  }}));"
      },
