        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": { "parameters": [
          { "name": "campaign_id", "value": "={{ $json.campaign_id }}" },
          { "name": "source",      "value": "={{ $json.source }}" },
